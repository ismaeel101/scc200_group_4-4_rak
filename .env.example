# Copy this file to .env and fill the real values. DO NOT commit .env or any real secrets.
# This file contains example environment variables used by docker-compose for local testing.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb

# Services ports (optional overrides)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# API URLs
VITE_API_URL=http://backend:${BACKEND_PORT:-8000}

# Redis
REDIS_URL=redis://redis:6379/0

# Optional explicit DATABASE_URL (uncomment to override constructed value):
# DATABASE_URL=postgresql://postgres:changeme@db:5432/appdb